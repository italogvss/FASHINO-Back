    <UserSecretsId>72cf564d-c336-423e-9b2b-c609cc950926</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\DockerCompose.dcproj</DockerComposeProjectPath>

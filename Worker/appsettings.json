{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=fashino;Username=postgres;Password=postgres"
  },

  "AppConfigurations": {
    "MaxFileSizeMB": 25,
    "AllowedMimes": "image/jpeg,image/png",
    "MaxJobRetry": 3,
    "PollingIntervalSeconds": 15
  },

  "FashnAiConfiguration": {
    "isDevelopment": true
  },

  "MinIO": {
    "Endpoint": "minio:9000",
    "AccessKey": "admin",
    "ExternalUrl": "localhost:9000",
    "SecretKey": "admin123",
    "UseSSL": false,
    "BucketName": "fashino"
  }
}
